{
    "name": "@formula-monks/renderizr",
    "version": "2.5.0",
    "private": true,
    "description": "Render a Structurizr workspace — its diagrams, documentation and architecture decisions — as a static site, or as a single self-contained HTML file with no network requests.",
    "keywords": [
        "structurizr",
        "c4",
        "c4-model",
        "architecture",
        "architecture-diagrams",
        "architecture-as-code",
        "diagrams",
        "documentation",
        "adr",
        "architecture-decision-records",
        "static-site",
        "static-site-generator",
        "single-file",
        "offline",
        "cli",
        "vite"
    ],
    "homepage": "https://github.com/FormulaMonks/renderizr#readme",
    "bugs": {
        "url": "https://github.com/FormulaMonks/renderizr/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FormulaMonks/renderizr.git",
        "directory": "."
    },
    "license": "MIT",
    "author": "Monks Tech Services (https://www.monkstechservices.com)",
    "contributors": [
        "Andrés Zorro <andres.zorro@monks.com> (https://github.com/andreszorro-monks)"
    ],
    "type": "module",
    "bin": {
        "renderizr": "scripts/build.js"
    },
    "exports": {
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=22.13",
        "pnpm": ">=10"
    },
    "files": [
        "scripts",
        "!scripts/**/*.test.js",
        "!scripts/__fixtures__",
        "!scripts/mermaid/generate",
        "src",
        "public",
        "index.html",
        "tsconfig.json",
        "NOTICE",
        "THIRD-PARTY-NOTICES.md",
        "licenses"
    ],
    "scripts": {
        "dev": "vite",
        "render": "tsc && node scripts/build.js",
        "preview": "node scripts/build.js architecture/workspace.json && vite preview -- architecture/workspace.json",
        "lint": "biome ci .",
        "lint:renovate": "pnpm dlx --package renovate renovate-config-validator --strict",
        "format": "biome check --write .",
        "fixtures:acceptance": "node test/__fixtures__/acceptance/export.js && biome format --write test/__fixtures__/acceptance/workspace.json",
        "architecture:merge": "node architecture/scripts/merge.js",
        "mermaid:parser": "node scripts/mermaid/generate/index.js",
        "fixtures:large": "node test/support/large-landscape.js",
        "typecheck": "tsc --noEmit",
        "test": "node --test scripts/*.test.js scripts/mermaid/*.test.js \"test/!(acceptance).test.js\" && node --test test/acceptance.test.js",
        "test:structurizr": "node --test test/structurizr-pipeline.test.js",
        "test:coverage": "node --test --experimental-test-coverage scripts/*.test.js scripts/mermaid/*.test.js test/*.test.js",
        "release:pr": "./scripts/release.sh pr",
        "release:tag": "./scripts/release.sh tag",
        "hooks": "husky || true"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.0.0",
        "@commitlint/cli": "^21.0.0",
        "@commitlint/config-conventional": "^21.0.0",
        "@types/node": "^24.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "czg": "^1.14.0",
        "fast-check": "^4.10.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.0",
        "rollup": "4.64.7",
        "typescript": "^7.0.0"
    },
    "dependencies": {
        "@dagrejs/dagre": "3.1.1",
        "@xyflow/react": "^12.12.0",
        "bootstrap-icons": "^1.13.2",
        "highlight.js": "^11.12.0",
        "history": "^5.3.0",
        "markdown-it": "^15.0.0",
        "markdown-it-anchor": "^10.0.0",
        "markdown-it-shift-headings": "^1.0.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "vite": "^7.3.7"
    }
}
