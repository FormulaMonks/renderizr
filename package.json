{
    "name": "@formula-monks/renderizr",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "bin": {
        "renderizr": "scripts/build.js",
        "build": "scripts/build.js"
    },
    "engines": {
        "node": ">=20"
    },
    "files": [
        "scripts",
        "src",
        "vendor",
        "public",
        "index.html",
        "tsconfig.json"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc && node scripts/build.js",
        "test": "node --test scripts/*.test.js",
        "preview": "vite preview",
        "sync:vendor": "node scripts/sync-vendor.js",
        "hooks": "husky || true"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.8.2",
        "@commitlint/cli": "^19.3.0",
        "@commitlint/config-conventional": "^19.2.2",
        "@types/jquery": "^3.5.30",
        "@types/markdown-it": "^14.1.1",
        "@types/node": "^22.10.2",
        "czg": "^1.9.3",
        "husky": "^9.0.11",
        "lint-staged": "^15.2.7",
        "typescript": "^5.5.2"
    },
    "dependencies": {
        "@dagrejs/dagre": "1.1.8",
        "@dagrejs/graphlib": "2.2.4",
        "@joint/core": "4.1.3",
        "@joint/layout-directed-graph": "4.1.3",
        "highlight.js": "^11.9.0",
        "history": "^5.3.0",
        "jquery": "3.6.3",
        "markdown-it": "^14.1.0",
        "markdown-it-anchor": "^9.0.1",
        "markdown-it-shift-headings": "^1.0.2",
        "vite": "^5.2.0"
    }
}
