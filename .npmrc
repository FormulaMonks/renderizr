# Read by both npm and pnpm.

# Spelled out rather than left to the default so that a fork, a CI runner or a
# developer with a private registry in ~/.npmrc resolves @formula-monks/* and
# every transitive dependency from public npm, and nowhere else.
registry=https://registry.npmjs.org/

# pnpm-lock.yaml is the lockfile. npm installs work (that is what `npx
# github:FormulaMonks/renderizr` does), but they must not leave a second,
# divergent lockfile behind — see CONTRIBUTING.md, "Toolchain".
package-lock=false

# Publish settings — access, provenance — live in package.json `publishConfig`
# so they travel with the package instead of depending on the machine.
