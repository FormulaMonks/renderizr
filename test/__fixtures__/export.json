        "systemContextViews": [
            {
                "key": "AutoFrame",
                "order": 1,
                "softwareSystemId": "2",
                "title": "Export in context",
                "description": "A view that stores neither dimensions nor a paper size, so its export takes the frame Auto would set: the content plus 400, centered. Its description runs long enough that the title block clamps it after four lines, which leaves the rest of this sentence out of the file and ends the last line it keeps with an ellipsis. More words follow here so that even a wide canvas needs more than four lines to hold them all, and the clamp shows in every export of this view. The reader never sees these last sentences in the file, only in the toolbar's description, which keeps the whole text. They exist to make the description long, in any font the export uses and at any width the canvas has, so that a test and a person checking an export by hand both see where the title block stops.",
                "elements": [
