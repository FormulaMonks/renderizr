{
    "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
    "files": {
        "includes": [
            "**",
            "!**/architecture/workspace.json",
            "!**/test/__fixtures__/amazon-web-services.json",
            "!**/test/__fixtures__/big-bank-plc.json",
            "!**/test/__fixtures__/big-bank-plc-tight.json",
            "!**/test/__fixtures__/big-bank-plc-stored.json",
            "!**/test/__fixtures__/groups.json",
            "!**/test/__fixtures__/enterprise-dsl/remote",
            "!**/test/__fixtures__/themes",
            "!**/scripts/__fixtures__/structurizr",
            "!**/scripts/mermaid/parser.js"
        ]
    },
    "assist": { "actions": { "source": { "organizeImports": "off" } } },
    "linter": {
        "enabled": true,
        "domains": { "react": "recommended" },
        "rules": {
            "preset": "recommended",
            "style": {
                "noNonNullAssertion": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/__fixtures__/**/*.svg"],
            "linter": {
                "rules": { "a11y": { "noSvgWithoutTitle": "off" } }
            }
        },
        {
            "includes": ["CHANGELOG.md"],
            "formatter": { "enabled": false }
        }
    ],
    "css": {
        "parser": {
            "cssModules": true
        }
    },
    "markdown": {
        "parser": { "frontmatter": true }
    },
    "yaml": {
        "formatter": { "indentWidth": 2 }
    },
    "formatter": {
        "indentWidth": 4,
        "indentStyle": "space"
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}
