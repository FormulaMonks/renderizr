{
    "$schema": "https://biomejs.dev/schemas/1.8.1/schema.json",
    "files": {
        "ignore": [
            "architecture/workspace.json",
            "test/__fixtures__/amazon-web-services.json",
            "test/__fixtures__/big-bank-plc.json",
            "test/__fixtures__/big-bank-plc-tight.json",
            "test/__fixtures__/big-bank-plc-stored.json",
            "test/__fixtures__/groups.json",
            "test/__fixtures__/themes",
            "scripts/__fixtures__/structurizr",
            "scripts/mermaid/parser.js",
            "test/__fixtures__/mermaid-flowchart.json"
        ]
    },
    "organizeImports": {
        "enabled": false
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noNonNullAssertion": "off"
            }
        }
    },
    "formatter": {
        "indentWidth": 4,
        "indentStyle": "space"
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}
